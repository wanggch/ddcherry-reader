{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DDCherry Reader",
  "version": "0.1.0",
  "identifier": "com.markdownreaderpro.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Markdown Reader Pro",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' asset:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mkd", "mdx", "txt"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor"
      }
    ]
  }
}
