{
  "name": "markdown-reader-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:core": "pnpm --filter @md-reader/core dev",
    "dev:extension": "pnpm --filter @md-reader/extension dev",
    "dev:desktop": "pnpm --filter @md-reader/desktop tauri:dev",
    "build:core": "pnpm --filter @md-reader/core build",
    "build:extension": "pnpm build:core && pnpm --filter @md-reader/extension build",
    "build:desktop": "pnpm build:core && pnpm --filter @md-reader/desktop build",
    "build:all": "pnpm build:core && pnpm build:extension && pnpm build:desktop",
    "test": "pnpm -r test",
    "package:extension": "pnpm --filter @md-reader/extension package",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
